# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
*.whl

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env.local
*.env

# ── Secrets — NEVER commit these ──────────────────────────────────────────────
.env

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/settings.json
*.swp
*.swo
Thumbs.db

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Model weights and checkpoints (too large for GitHub) ──────────────────────
outputs/checkpoints/
*.pth
*.pt
*.bin
*.safetensors
unsloth_compiled_cache/
*.cache/
.cache/

# ── HuggingFace cache ─────────────────────────────────────────────────────────
huggingface/
.huggingface/
cache/

# ── Raw large data files (download via scripts/download_datasets.py) ──────────
data/raw/
*.jsonl

# ── Allow curated processed data (small, needed for reproducibility) ──────────
!data/processed/sft/causal_train.jsonl
!data/processed/sft/noncausal_train.jsonl
!data/processed/dpo/dpo_pairs_v3.jsonl
!data/processed/dpo/dpo_pairs_combined.jsonl
!data/processed/dpo/dpo_pairs_causal_v2.jsonl
!data/processed/dpo/dpo_pairs_gsm8k.jsonl
!data/processed/dpo/rejected_chains_gsm8k.jsonl
!data/processed/dpo/detailed_pns.jsonl
!data/processed/dpo/gsm8k_causal_train.jsonl
!data/processed/self_distill/causal_300.jsonl
!data/processed/self_distill/noncausal_messages.jsonl
!data/processed/self_distill/iter_1/*.jsonl
!data/processed/self_distill/iter_2/*.jsonl

# ── Allow evaluation results (small CSVs + result JSONLs for paper) ───────────
!outputs/results/
!outputs/results/**/*.jsonl
!outputs/results/**/*.csv
!outputs/results/**/*.json

# ── Allow training logs (useful for reproducibility) ─────────────────────────
!outputs/logs/
!outputs/logs/*.txt
!outputs/logs/**/*.log
!outputs/logs/**/*.json

# ── Training logs generated during runs ───────────────────────────────────────
*.log
