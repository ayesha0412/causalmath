!data/dpo/rejected_chains_gsm8k.jsonl
!data/dpo/detailed_pns.jsonl
!data/dpo/sample10.jsonl

# Allow self-distillation training data
!data/self_distill/causal_300.jsonl
!data/self_distill/seed_hard100.jsonl
!data/self_distill/seed_hard250.jsonl
!data/self_distill/noncausal_messages.jsonl
!data/self_distill/iter1/*.jsonl
!data/self_distill/iter2/*.jsonl

# Allow all files in Self_distill/ directory
!Self_distill/
!Self_distill/**
