# Allow DPO training pairs (curated, needed for reproducibility)
!data/dpo/dpo_pairs_v3.jsonl
!data/dpo/dpo_pairs_gsm8k.jsonl
!data/dpo/dpo_pairs_combined.jsonl
!data/dpo/dpo_pairs_causal_v2.jsonl
