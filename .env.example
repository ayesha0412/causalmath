# Copy this file to .env and fill in real values.
# .env is in .gitignore — never commit actual keys.

# Ollama model name (used by src/causalmath/models/ollama_client.py)
# Must match a model you have pulled: ollama pull qwen3:14b
QWEN_MODEL=qwen3:14b

# Ollama server URL — change port if you run multiple Ollama instances
OLLAMA_BASE_URL=http://localhost:11434/v1

# HuggingFace token — required to download gated models (e.g. Llama)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Optional: Weights & Biases for training run tracking
# Set report_to: "wandb" in configs/training_config.yaml to activate
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=causalmath
WANDB_ENTITY=your_wandb_entity_here
